<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Startdesign während der Initialisierung der Flutter-Anwendung -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Standarddesign nach dem Start der Flutter-Anwendung -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>

    <!-- Design der Karten im Quick-Track-Widget -->
    <style name="QuickTrackCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/quick_track_card</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#263B56</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
